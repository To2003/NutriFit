# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local al repo.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (aistudio.google.com) — modelo Flash vigente con soporte de imágenes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Respaldo en orden, separados por coma. En el plan gratis cada modelo tiene su propio cupo diario (~20 consultas).
GEMINI_FALLBACK_MODELS=gemini-3-flash,gemini-2.5-flash-lite
# 1 = también usar IA en feedback por carga, cierre del día y sesiones (necesita más cupo / facturación)
GEMINI_RICH=

# USDA FoodData Central (api.data.gov)
USDA_API_KEY=

# Web Push (generá el par con: pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com

# Secreto compartido con pg_cron (Vault: cron_secret)
CRON_SECRET=
